---
// Temporary: lets you try colour palettes while we decide. Remove before going live.
const palettes = [
  { id: 'oat', name: 'Oat & moss' },
  { id: 'fog', name: 'Valley fog' },
  { id: 'sand', name: 'Pahadi sand' },
  { id: 'night', name: 'Soft night' },
];
---
<div class="palette-switch" role="group" aria-label="Try a colour palette">
  <span>palette</span>
  {palettes.map((p) => (
    <button type="button" data-set-palette={p.id} title={p.name} aria-label={p.name} class={`sw sw-${p.id}`}></button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-set-palette]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.dataset.setPalette!;
      document.documentElement.dataset.palette = id;
      try { localStorage.setItem('palette', id); } catch (e) {}
    });
  });
</script>
