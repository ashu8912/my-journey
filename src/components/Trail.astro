---
// The mountain on the right. The goat climbs it as you scroll through the chapters.
import Goat from './Goat.astro';
---
<aside class="trail" aria-label="Story progress">
  <svg viewBox="0 0 200 800" class="trail-svg">
    <path class="mtn-back" d="M0 800 L0 470 L45 380 L80 410 L130 250 L200 330 L200 800 Z" />
    <path class="mtn" d="M0 800 L0 640 L40 520 L70 300 L100 40 L128 150 L150 260 L200 560 L200 800 Z" />
    <path class="snow" d="M100 40 L84 168 L96 150 L106 172 L118 136 L128 150 Z" />
    <path id="trailPath" class="trail-path" d="M110 785 C 40 740, 170 690, 95 640 S 30 540, 110 500 S 160 400, 90 360 S 45 260, 105 220 S 120 120, 100 52" />
    <g id="trailDots"></g>
    <Goat id="trailGoat" width="46" height="38" x="0" y="0" />
  </svg>
</aside>

<script>
  const path = document.getElementById('trailPath') as unknown as SVGPathElement | null;
  const goat = document.getElementById('trailGoat');
  const flip = goat?.querySelector('.goat-flip');
  const dotsG = document.getElementById('trailDots');
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];

  if (path && goat && flip && dotsG && chapters.length > 1) {
    const len = path.getTotalLength();
    const n = chapters.length;
    const NS = 'http://www.w3.org/2000/svg';

    const dots = chapters.map((c, i) => {
      const p = path.getPointAtLength((len * i) / (n - 1));
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', 'dot');
      g.setAttribute('role', 'link');
      g.setAttribute('tabindex', '0');
      g.setAttribute('aria-label', `Jump to ${c.dataset.year}`);
      const circle = document.createElementNS(NS, 'circle');
      circle.setAttribute('cx', String(p.x));
      circle.setAttribute('cy', String(p.y));
      circle.setAttribute('r', '6');
      const text = document.createElementNS(NS, 'text');
      const left = p.x > 100;
      text.setAttribute('x', String(left ? p.x - 12 : p.x + 12));
      text.setAttribute('y', String(p.y + 4));
      text.setAttribute('text-anchor', left ? 'end' : 'start');
      text.textContent = c.dataset.year ?? '';
      g.append(circle, text);
      const go = () => c.scrollIntoView({ behavior: 'smooth', block: 'start' });
      g.addEventListener('click', go);
      g.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); });
      dotsG.append(g);
      return g;
    });

    let walkTimer: number | undefined;
    let ticking = false;

    const update = () => {
      ticking = false;
      const anchor = window.scrollY + window.innerHeight * 0.45;
      const tops = chapters.map((c) => c.getBoundingClientRect().top + window.scrollY);
      let idx = 0;
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom || anchor >= tops[n - 1]) idx = n - 1;
      else if (anchor > tops[0]) {
        for (let i = 0; i < n - 1; i++) {
          if (anchor < tops[i + 1]) { idx = i + (anchor - tops[i]) / (tops[i + 1] - tops[i]); break; }
        }
      }
      const L = (len * idx) / (n - 1);
      const p = path.getPointAtLength(L);
      const q = path.getPointAtLength(Math.min(len, L + 3));
      goat.setAttribute('x', String(p.x - 23));
      goat.setAttribute('y', String(p.y - 35));
      if (Math.abs(q.x - p.x) > 0.3) flip.setAttribute('transform', q.x < p.x ? 'translate(120 0) scale(-1 1)' : '');
      dots.forEach((d, i) => d.classList.toggle('reached', i <= idx + 0.02));
      goat.classList.add('walking');
      clearTimeout(walkTimer);
      walkTimer = window.setTimeout(() => goat.classList.remove('walking'), 220);
    };

    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
    goat.classList.remove('walking');
  }
</script>
